# ── Firebase (required for bridge.js) ──────────────────────────────────────
# From: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content on ONE LINE (stringify it first)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# From: Firebase Console → Project Settings → Your Apps → Realtime Database → databaseURL
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# ── Serial port (optional, auto-detected if omitted) ────────────────────────
# SERIAL_PORT=/dev/cu.usbmodem101
# BAUD_RATE=9600

# ── Throttle: minimum ms between Firebase writes (default 100 = 10 Hz) ──────
# UPDATE_MS=100
